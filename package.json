{
  "name": "llm-api-proxy-recorder-desktop",
  "private": true,
  "version": "2.2.1",
  "scripts": {
    "desktop:sidecar": "bash scripts/build-sidecar.sh",
    "desktop:sidecar:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-sidecar.ps1",
    "desktop:build": "npm run desktop:sidecar && tauri build",
    "desktop:build:windows": "npm run desktop:sidecar:windows && tauri build --bundles nsis",
    "desktop:dev": "npm run desktop:sidecar && tauri dev"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4"
  }
}
