{
  "name": "sona-code-desktop",
  "private": true,
  "version": "2.2.1",
  "description": "Sona Code desktop application with a bundled offline Chromium runtime",
  "main": "electron/main.js",
  "scripts": {
    "desktop:sidecar": "bash scripts/build-sidecar.sh",
    "desktop:sidecar:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-sidecar.ps1",
    "desktop:build": "npm run desktop:sidecar && tauri build",
    "desktop:build:windows": "npm run desktop:sidecar:windows && tauri build --bundles nsis",
    "desktop:build:windows:electron": "npm run desktop:sidecar:windows && electron-builder --win nsis --x64",
    "desktop:build:windows:electron:package": "electron-builder --win nsis --x64",
    "desktop:dev": "npm run desktop:sidecar && tauri dev"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "electron": "44.4.5",
    "electron-builder": "26.0.12",
    "rcedit": "5.0.2"
  }
}
