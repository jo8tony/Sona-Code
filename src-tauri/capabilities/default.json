{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Desktop window permissions for the bundled UI and local workspace",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:8117/*"]
  },
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "notification:default"
  ]
}
